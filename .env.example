# OpenAI API Key (Required)
OPENAI_API_KEY=your-openai-api-key-here

# Model Configuration
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# RAG Pipeline Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# Evaluation Settings
TESTSET_SIZE=50

# Flask Settings
FLASK_PORT=5050
FLASK_DEBUG=true
